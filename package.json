{
	"name": "exec-near",
	"version": "0.0.0",
	"description": "Execute a program near a search result",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/node-exec-near.git"
	},
	"keywords": [],
	"type": "module",
	"bin": {
		"exec-near": "./bin/index.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run lint && npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np --any-branch",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"find-git-root": "^1.1.0",
		"find-up-simple": "^1.0.1",
		"install": "^0.13.0",
		"kleur": "^4.1.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@e18e/cli": "^0.5.0",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.12.0",
		"@vitest/coverage-v8": "^4.1.2",
		"concurrently": "^9.2.1",
		"np": "^11.0.2",
		"tsdown": "^0.21.7",
		"vitest": "^4.1.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40"
}
