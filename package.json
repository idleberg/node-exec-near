{
	"name": "exec-near",
	"version": "0.1.0",
	"description": "Run commands in the directory of the nearest matching file",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/node-exec-near.git"
	},
	"keywords": [],
	"type": "module",
	"bin": {
		"exec-near": "./bin/index.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"bin/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run lint && npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np --any-branch",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"empathic": "^2.0.0",
		"find-git-root": "^1.1.0",
		"install": "^0.13.0",
		"kleur": "^4.1.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@e18e/cli": "^0.5.0",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.12.0",
		"@vitest/coverage-v8": "^4.1.2",
		"concurrently": "^9.2.1",
		"np": "^11.0.2",
		"tsdown": "^0.21.7",
		"vitest": "^4.1.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
